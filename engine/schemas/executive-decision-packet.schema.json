{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executive Decision Packet",
  "type": "object",
  "required": [
    "artifact",
    "request_type",
    "selected_skill_chain",
    "decision_needed",
    "facts",
    "assumptions",
    "hypotheses",
    "missing_evidence",
    "confidence",
    "risk_chain",
    "scorecard",
    "recommended_action",
    "guardrails"
  ],
  "properties": {
    "artifact": { "const": "Executive Decision Packet" },
    "request_type": { "type": "string" },
    "selected_skill_chain": { "type": "array", "items": { "type": "string" } },
    "decision_needed": { "type": "string" },
    "facts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "hypotheses": { "type": "array", "items": { "type": "string" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string" },
    "risk_chain": { "type": "array" },
    "scorecard": { "type": "object" },
    "recommended_action": { "type": "object" },
    "guardrails": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}

