{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Board Question Memory",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "source_ref": {"type": "string"},
    "topic": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "persona": {"type": "string"},
          "question": {"type": "string"},
          "pressure_level": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
