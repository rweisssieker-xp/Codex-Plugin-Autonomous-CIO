  "properties": {
    "reprioritization_required": {"type": "boolean"},
    "promote": {"type": "array", "items": {"type": "string"}},
    "pause_or_defer": {"type": "array", "items": {"type": "string"}},
    "protect": {"type": "array", "items": {"type": "string"}},
    "roadmap_rule": {"type": "string"}
  }
}
