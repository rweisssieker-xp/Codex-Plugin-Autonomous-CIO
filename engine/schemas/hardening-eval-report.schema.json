{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardening Eval Report",
  "type": "object",
  "required": ["artifact", "hardening_eval_report", "facts", "assumptions", "hypotheses", "missing_evidence", "confidence", "recommended_action", "guardrails"],
  "properties": {
    "artifact": {"const": "Hardening Eval Report"},
    "hardening_eval_report": {
      "type": "object",
      "required": ["base_eval_report", "hardening_checks"],
      "properties": {
        "base_eval_report": {"type": "object"},
        "hardening_checks": {"type": "object"}
      }
    }
  }
}
